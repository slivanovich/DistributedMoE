@startuml
title Class Diagram (full)

' Make cross-package references unambiguous.
set namespaceSeparator ::

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

left to right direction

' -------------------- MoE runtime --------------------

package "Server" {
  class DistMoEBlock <<nn.Module>> {
    +setup_health_check(tte_config)
    +initialize_io_buffers()
    +disable_experts_block(experts_block_index)
    +enable_experts_block(experts_block_index)
  }

  class HostPipelineTask {
    +dispatch(input_batch, ...)
    +combine(active_pipeline_tasks, output_batch, combining)
    +abort()
    +close()
  }
}

package "Client" {
  class DistExpertsBlock <<nn.Module>> {
    +setup_health_check(config, tte_config)
    +initialize_io_buffers()
    +parse_host_io_buffer_descriptors(metadata)
    +async_main_loop()
  }

  class ExpertsBlockPipelineTask {
    +run(experts_block_index, host_input_buffers_transfer_descs, host_output_buffers_transfer_descs)
  }
}

package "pools" {
  class Buffer {
    +id
    +data
    +cuda_stream
    +read_from(remote_name, src_descs)
    +write_to(remote_name, dst_descs)
    +close()
  }

  class BuffersPool {
    +acquire()
    +release(buffer_index)
    +close()
  }

  class ExpertBlockMetaData <<dataclass>> {
    +is_alive
    +alive_event
    +experts_block_index
    +expert_indexes
  }

  class ExpertBlocksPool {
    +aquire()
    +release(experts_block_index)
    +mark_alive(experts_block_index)
    +mark_dead(experts_block_index)
    +close()
  }
}

package "metrics" {
  class MetricsCollectorConfig <<dataclass>>

  class MetricsCollector {
    +start_forward_pass()
    +end_forward_pass()
    +start_dispatch(task_id)
    +end_dispatch(task_id)
    +start_combine(task_id)
    +end_combine(task_id)
    +start_expert_run(task_id, experts_block_index)
    +end_expert_run(task_id)
    +record_transfer_start(task_id, transfer_type, bytes_count)
    +record_transfer_end(task_id, transfer_type)
  }

  class DispatchMetrics <<dataclass>>
  class CombineMetrics <<dataclass>>
  class ExpertsRunMetrics <<dataclass>>
  class ExpertsBlockMetrics <<dataclass>>
  class ForwardMetrics <<dataclass>>
  class Metrics <<dataclass>>
}

package "reference" {
  class Qwen3MoEMLP <<nn.Module>>
  class Qwen3SparseMoEBlock <<nn.Module>>
}

' Shared types
enum P2PHeaders <<Enum>>

class ExpertMetaData <<dataclass>> {
  +block_indexes
  +expert_shared_rate
  +expert_weights
  +expert_token_indexes
  +expert_total_activations
  +expert_offsets
}

class DistMoEBlockConfig <<dataclass>> {
  +backend
  +number_of_experts
  +expert_blocks
  +number_of_io_buffers
  +io_buffer_size
  +top_k
  +hidden_features
  +dtype
  +moe_device
  +eb_devices
  +forward_timeout
  +host_health_check_ports
  +remote_health_check_ports
}

class PipelineTask {
  +name
  +release_input_buffer()
  +release_output_buffer()
  +close()
}

' -------------------- TensorTransferEngine runtime --------------------

package "TensorTransferEngine" {
  enum TensorTransferEngineBackend <<Enum>>

  class TensorTransferEngineConfig <<dataclass>>

  abstract class TensorTransferEngine <<abstract>> {
    +handshake()
    +register_batch(...)
    +deregister_batch(...)
    +read_batch_transfer(...)
    +write_batch_transfer(...)
    +serialize_descs(...)
    +deserialize_descs(...)
    +serialize_p2p_packet(header, body)
    +deserialize_p2p_packet(packet)
    +async_send_metadata_to(remote_name, header, body)
    +async_get_metadata_from(remote_name)
    +close()
  }

  class MCTETensorTransferEngine
  class NIXLTensorTransferEngine

  package "utils" {
    enum TransferProtocol <<Enum>>
    enum HandshakeType <<Enum>>
    enum TransferStatus <<Enum>>
    class Transfer <<dataclass>>
    class P2PPair <<dataclass>>
  }

  ' Layout hints: keep core TTE types arranged horizontally.
  TensorTransferEngineBackend -[hidden]-> TensorTransferEngineConfig
  TensorTransferEngineConfig -[hidden]-> TensorTransferEngine
  TensorTransferEngine -[hidden]-> MCTETensorTransferEngine
  MCTETensorTransferEngine -[hidden]-> NIXLTensorTransferEngine
}

